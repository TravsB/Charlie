# Local-only PostgreSQL settings for docker-compose.yml.
PGDATABASE=nexus_ai_dev
PGUSER=nexus_ai
PGPASSWORD=nexus_ai_dev
DATABASE_URL=postgresql://nexus_ai:nexus_ai_dev@127.0.0.1:5432/nexus_ai_dev

# Redis is provisioned for the later event-bus phase; Phase 1 does not connect to it.
REDIS_URL=redis://127.0.0.1:6379/0

# Replace with a locally generated value before enabling session-based features.
SESSION_SECRET=replace-with-a-long-random-value
